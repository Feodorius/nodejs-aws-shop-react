    "msw": "^2.7.3",
    "prettier": "^3.5.3",
    "typescript": "^5.8.3",
    "vite": "^6.3.3",
    "vitest": "^3.1.2"
  },
  "msw": {
    "workerDirectory": "public"
  },
  "engines": {
    "node": ">=18.0.0"
